---
import '@fontsource-variable/atkinson-hyperlegible-next';
import '@fontsource-variable/newsreader';
import '../styles/global.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { contactEmail, dialogUrl, navigation, pageUrl, t, unifrUrl, type Locale } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  slug: string;
  translations: Locale[];
  /** Wider main column, for galleries and the home page. */
  wide?: boolean;
}

const { title, description, locale, slug, translations, wide = false } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      translations.map((other) => (
        <link rel="alternate" hreflang={other} href={new URL(pageUrl(other, slug), Astro.site)} />
      ))
    }
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:rounded-md focus:bg-background focus:px-4 focus:py-2"
    >
      {t(locale, 'nav.skip')}
    </a>
    <header class="bg-primary text-primary-foreground">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-6 pt-5">
        <a href={pageUrl(locale, 'index')} class="flex items-center gap-3">
          <img src="/eddb.svg" alt="" width="40" height="40" />
          <span>
            <span class="block text-2xl font-semibold tracking-wide">EDDB</span>
            <span class="block text-sm opacity-90">{t(locale, 'site.tagline')}</span>
          </span>
        </a>
        <LanguageSwitcher locale={locale} slug={slug} translations={translations} />
      </div>
      <nav aria-label={t(locale, 'nav.main')} class="mx-auto max-w-5xl px-6 pb-3 pt-4">
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          {
            navigation.map((item) => (
              <li>
                <a
                  href={'dialog' in item ? dialogUrl(locale, item.slug) : pageUrl(locale, item.slug)}
                  aria-current={item.slug === slug ? 'page' : undefined}
                  class:list={[
                    'inline-block border-b-2 pb-1 hover:border-primary-foreground',
                    item.slug === slug ? 'border-primary-foreground font-semibold' : 'border-transparent',
                  ]}
                >
                  {t(locale, `nav.${item.slug}`)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <main id="content" class:list={['mx-auto w-full flex-1 px-6 py-12', wide ? 'max-w-5xl' : 'max-w-3xl']}>
      <slot />
    </main>
    <footer class="border-t">
      <div
        class="mx-auto flex max-w-5xl flex-wrap justify-between gap-x-8 gap-y-2 px-6 py-6 text-sm text-muted-foreground"
      >
        <span>{t(locale, 'footer.service')}</span>
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          <li>
            {t(locale, 'footer.contact')}{' '}
            <a class="underline underline-offset-4" href={`mailto:${contactEmail}`}>{contactEmail}</a>
          </li>
          <li><a class="underline underline-offset-4" href={unifrUrl(locale, 'impressum')}>{t(locale, 'footer.impressum')}</a></li>
          <li><a class="underline underline-offset-4" href={unifrUrl(locale, 'legal')}>{t(locale, 'footer.legal')}</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
