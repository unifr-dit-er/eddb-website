---
import '@fontsource-variable/atkinson-hyperlegible-next';
import '@fontsource-variable/newsreader';
import '../styles/global.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { contactEmail, pageUrl, t, unifrUrl, type Locale } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  slug: string;
  translations: Locale[];
}

const { title, description, locale, slug, translations } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      translations.map((other) => (
        <link rel="alternate" hreflang={other} href={new URL(pageUrl(other, slug), Astro.site)} />
      ))
    }
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:rounded-md focus:bg-background focus:px-4 focus:py-2"
    >
      {t(locale, 'nav.skip')}
    </a>
    <!-- A single white header: the Unifr logo, which must keep its white
         background (Service communication), then EDDB, with a midnight blue
         rule below. The logo PNG is 82 px high: shown at exactly half (41 px),
         it stays sharp on high-density screens. The divider shows whenever
         EDDB sits beside the logo. -->
    <header class="border-b-4 border-primary bg-white text-primary-ink">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-6 py-4">
        <div class="flex items-center gap-x-6 gap-y-3 sm:flex-wrap">
          <a href={unifrUrl(locale, 'home')} class="inline-block shrink-0">
            <!-- Narrow screens: the signet alone, as on unifr.ch. -->
            <img src="/unifr-signet.svg" alt={t(locale, 'site.unifr')} width="40" height="48" class="sm:hidden" />
            <img src="/unifr.png" alt={t(locale, 'site.unifr')} width="250" height="41" class="hidden sm:block" />
          </a>
          <span class="h-10 w-px shrink-0 bg-border sm:hidden md:block"></span>
          <a href={pageUrl(locale, 'index')} class="flex min-w-0 items-center gap-3">
            <svg
              width="34"
              height="34"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="shrink-0"
            >
              <path d="M12 4L20 8L12 12L4 8L12 4Z"></path>
              <path d="M20 12L12 16L4 12"></path>
              <path d="M20 16L12 20L4 16"></path>
            </svg>
            <span>
              <span class="block text-xl font-semibold tracking-wide">EDDB</span>
              <span class="block text-sm text-muted-foreground">{t(locale, 'site.tagline')}</span>
            </span>
          </a>
        </div>
        <LanguageSwitcher locale={locale} slug={slug} translations={translations} />
      </div>
    </header>
    <main id="content" class="flex-1">
      <slot />
    </main>
    <footer class="border-t">
      <div
        class="mx-auto flex max-w-5xl flex-wrap justify-between gap-x-8 gap-y-2 px-6 py-6 text-sm text-muted-foreground"
      >
        <span>{t(locale, 'footer.service')}</span>
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          <li>
            {t(locale, 'footer.contact')}{' '}
            <a class="underline underline-offset-4" href={`mailto:${contactEmail}`}>{contactEmail}</a>
          </li>
          <li><a class="underline underline-offset-4" href={unifrUrl(locale, 'impressum')}>{t(locale, 'footer.impressum')}</a></li>
          <li><a class="underline underline-offset-4" href={unifrUrl(locale, 'legal')}>{t(locale, 'footer.legal')}</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
