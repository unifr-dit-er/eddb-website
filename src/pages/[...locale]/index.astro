---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import OfferDialog from '../../components/OfferDialog.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { localeParam, pageUrl, splitEntryId, t } from '../../i18n/ui';
import { getPageRoutes } from '../../lib/pages';

export const getStaticPaths = (async () => {
  const routes = await getPageRoutes();
  return routes
    .filter(({ slug }) => slug === 'index')
    .map((route) => ({ params: { locale: localeParam(route.locale) }, props: route }));
}) satisfies GetStaticPaths;

const { page, locale, translations } = Astro.props;
const { Content } = await render(page);
const { title, description, cta } = page.data;
const offers = (await getCollection('offers', ({ id }) => splitEntryId(id).locale === locale)).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = (await getCollection('projects', ({ data }) => data.featured)).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
---

<Layout title={`EDDB · ${title}`} description={description} locale={locale} slug="index" translations={translations} wide>
  <div class="max-w-3xl">
    <h1 class="font-serif text-4xl leading-tight text-primary-ink sm:text-5xl">{title}</h1>
    <div class="prose-eddb mt-8">
      <Content />
    </div>
    {
      cta && (
        <a
          href={pageUrl(locale, cta.slug)}
          class="mt-8 inline-block rounded-md bg-primary px-5 py-3 font-semibold text-primary-foreground hover:opacity-90"
        >
          {cta.label}
        </a>
      )
    }
  </div>

  {
    offers.length > 0 && (
      <ul class="mt-14 grid gap-5 md:grid-cols-3">
        {offers.map((offer) => (
          <li>
            <a
              href={`#${splitEntryId(offer.id).slug}`}
              aria-haspopup="dialog"
              class="group flex h-full flex-col rounded-lg border bg-card p-6 hover:border-primary"
            >
              <h2 class="font-serif text-2xl text-primary-ink">{offer.data.title}</h2>
              <p class="mt-3 flex-1">{offer.data.summary}</p>
              <span class="mt-4 text-sm text-primary-ink underline underline-offset-4 group-hover:decoration-2">
                {t(locale, 'offers.more')} →
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
  {offers.map((offer) => <OfferDialog offer={offer} locale={locale} />)}

  {
    featured.length > 0 && (
      <section class="mt-16">
        <h2 class="font-serif text-3xl text-primary-ink">{t(locale, 'home.projects')}</h2>
        <div class="mt-6 grid gap-5 md:grid-cols-3">
          {featured.map((project) => (
            <ProjectCard project={project} locale={locale} />
          ))}
        </div>
        <p class="mt-6">
          <a class="text-primary-ink underline underline-offset-4 hover:decoration-2" href={pageUrl(locale, 'projects')}>
            {t(locale, 'home.allProjects')} →
          </a>
        </p>
      </section>
    )
  }
</Layout>

<script>
  // Each offer card links to #<slug>, the id of its dialog: the dialog opens
  // on a click as on a shared link (eddb.unifr.ch/#nocodb). Closing it (close
  // button, Escape, click on the backdrop) removes the hash again.
  function openFromHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    const target = id ? document.getElementById(id) : null;
    if (target instanceof HTMLDialogElement && !target.open) target.showModal();
  }

  for (const dialog of document.querySelectorAll('dialog')) {
    dialog.addEventListener('close', () => {
      if (location.hash === `#${dialog.id}`) history.replaceState(null, '', location.pathname + location.search);
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }

  window.addEventListener('hashchange', openFromHash);
  openFromHash();
</script>
