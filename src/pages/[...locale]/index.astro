---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ContentDialog from '../../components/ContentDialog.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { defaultLocale, localeParam, splitEntryId, t, type Locale } from '../../i18n/ui';

export const getStaticPaths = (async () => {
  const parts = (await getCollection('pages')).map((page) => ({ page, ...splitEntryId(page.id) }));
  const homes = parts.filter(({ page }) => page.data.kind === 'home');
  const translations = homes.map(({ locale }) => locale);
  return homes.map(({ page, locale }) => {
    const ofKind = (kind: 'section' | 'dialog') => parts.filter((part) => part.page.data.kind === kind);
    // Parts of this language. A dialog not yet translated falls back to
    // French, so that the call to action never points to a missing dialog.
    const sections = ofKind('section').filter((part) => part.locale === locale);
    const dialogs = [...new Set(ofKind('dialog').map(({ slug }) => slug))].map(
      (slug) =>
        (ofKind('dialog').find((d) => d.slug === slug && d.locale === locale) ??
          ofKind('dialog').find((d) => d.slug === slug && d.locale === defaultLocale))!,
    );
    return { params: { locale: localeParam(locale) }, props: { page, locale, translations, sections, dialogs } };
  });
}) satisfies GetStaticPaths;

interface Part {
  page: CollectionEntry<'pages'>;
  locale: Locale;
  slug: string;
}

const { page, locale, translations } = Astro.props;
const sections = Astro.props.sections as Part[];
const dialogs = Astro.props.dialogs as Part[];
const { Content } = await render(page);
const { title, description, cta } = page.data;

const offers = (await getCollection('offers', ({ id }) => splitEntryId(id).locale === locale)).sort(
  (a, b) => a.data.order - b.data.order,
);
const projects = (await getCollection('projects')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const featured = projects.filter(({ data }) => data.featured);
const more = projects.filter(({ data }) => !data.featured);
const renderedSections = await Promise.all(
  sections.map(async (section) => ({ ...section, Content: (await render(section.page)).Content })),
);
---

<Layout title={`EDDB · ${title}`} description={description} locale={locale} slug="index" translations={translations}>
  <div class="mx-auto max-w-5xl px-6 py-12">
    <div class="max-w-3xl">
      <h1 class="font-serif text-4xl leading-tight text-primary-ink sm:text-5xl">{title}</h1>
      <div class="prose-eddb mt-8">
        <Content />
      </div>
      {
        cta && (
          <a
            href={`#${cta.slug}`}
            aria-haspopup="dialog"
            class="mt-8 inline-block rounded-md bg-primary px-5 py-3 font-semibold text-primary-foreground hover:opacity-90"
          >
            {cta.label}
          </a>
        )
      }
    </div>

    {
      offers.length > 0 && (
        <ul class="mt-14 grid gap-5 md:grid-cols-3">
          {offers.map((offer) => (
            <li>
              <a
                href={`#${splitEntryId(offer.id).slug}`}
                aria-haspopup="dialog"
                class="group flex h-full flex-col rounded-lg border bg-card p-6 hover:border-primary"
              >
                <h2 class="font-serif text-2xl text-primary-ink">{offer.data.title}</h2>
                <p class="mt-3 flex-1">{offer.data.summary}</p>
                <span class="mt-4 text-sm text-primary-ink underline underline-offset-4 group-hover:decoration-2">
                  {t(locale, 'offers.more')} →
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  {
    renderedSections.map(({ page: section, slug, Content: SectionContent }) => (
      <section id={slug} class="border-y bg-muted/60">
        <div class="mx-auto grid max-w-5xl gap-x-12 gap-y-6 px-6 py-14 md:grid-cols-[1fr_2fr]">
          <div>
            <h2 class="font-serif text-3xl text-primary-ink md:sticky md:top-8">{section.data.title}</h2>
          </div>
          <div class="prose-eddb [&>h3:first-of-type]:mt-8">
            <SectionContent />
          </div>
        </div>
      </section>
    ))
  }

  {
    projects.length > 0 && (
      <section id="projects" class="mx-auto max-w-5xl px-6 py-14">
        <h2 class="font-serif text-3xl text-primary-ink">{t(locale, 'home.projects')}</h2>
        <p class="mt-4 max-w-3xl text-lg">{t(locale, 'home.projectsIntro')}</p>
        <div class="mt-8 grid gap-5 md:grid-cols-3">
          {featured.map((project) => (
            <ProjectCard project={project} locale={locale} />
          ))}
        </div>
        {more.length > 0 && (
          <details class="group mt-6">
            <summary class="inline-block cursor-pointer list-none rounded-md border px-4 py-2 font-semibold text-primary-ink hover:border-primary [&::-webkit-details-marker]:hidden">
              <span class="group-open:hidden">{t(locale, 'home.moreProjects')} ↓</span>
              <span class="hidden group-open:inline">{t(locale, 'home.fewerProjects')} ↑</span>
            </summary>
            <div class="mt-6 grid gap-5 md:grid-cols-3">
              {more.map((project) => (
                <ProjectCard project={project} locale={locale} />
              ))}
            </div>
          </details>
        )}
      </section>
    )
  }

  {
    offers.map((offer) => (
      <ContentDialog id={splitEntryId(offer.id).slug} title={offer.data.title} entry={offer} locale={locale} />
    ))
  }
  {dialogs.map(({ page: dialog, slug }) => <ContentDialog id={slug} title={dialog.data.title} entry={dialog} locale={locale} />)}
</Layout>

<script>
  // Each offer card and the call to action link to #<slug>, the id of a
  // dialog: it opens on a click as on a shared link (eddb.unifr.ch/#nocodb),
  // one dialog at a time. Closing it (close button, Escape, click on the
  // backdrop) removes the hash again.
  function openFromHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    const target = id ? document.getElementById(id) : null;
    if (!(target instanceof HTMLDialogElement) || target.open) return;
    for (const open of document.querySelectorAll('dialog[open]')) (open as HTMLDialogElement).close();
    target.showModal();
  }

  for (const dialog of document.querySelectorAll('dialog')) {
    dialog.addEventListener('close', () => {
      if (location.hash === `#${dialog.id}`) history.replaceState(null, '', location.pathname + location.search);
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }

  window.addEventListener('hashchange', openFromHash);
  openFromHash();
</script>
