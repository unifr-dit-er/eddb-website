---
import type { CollectionEntry } from 'astro:content';
import { localized, t, type Locale } from '../i18n/ui';

interface Props {
  project: CollectionEntry<'projects'>;
  locale: Locale;
}

const { project, locale } = Astro.props;
const { name, faculty, department, summary, funding, url } = project.data;
---

<article class="flex flex-col rounded-lg border bg-card p-5">
  <h3 class="text-lg font-semibold text-primary-ink">{localized(name, locale)}</h3>
  <p class="mt-1 text-sm text-muted-foreground">
    {localized(department, locale)} · {t(locale, `faculty.${faculty}`)}
  </p>
  <p class="mt-3 flex-1">{localized(summary, locale)}</p>
  <div class="mt-4 flex items-center justify-between gap-4 text-sm">
    {funding ? <span class="rounded-full bg-muted px-2.5 py-0.5">{t(locale, `funding.${funding}`)}</span> : <span />}
    {
      url && (
        <a class="text-primary-ink underline underline-offset-4 hover:decoration-2" href={url}>
          {t(locale, 'projects.visit')} →
        </a>
      )
    }
  </div>
</article>
