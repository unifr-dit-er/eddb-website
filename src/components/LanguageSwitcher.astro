---
import { languageNames, locales, pageUrl, t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** Slug of the current page, the same in every language. */
  slug: string;
}

const { locale, slug } = Astro.props;
---

<nav aria-label={t(locale, 'nav.languages')}>
  <ul class="flex gap-4 text-sm">
    {
      locales.map((other) => (
        <li>
          <a
            href={pageUrl(other, slug)}
            hreflang={other}
            lang={other}
            aria-current={other === locale ? 'true' : undefined}
            class:list={[
              'underline-offset-4 hover:underline',
              other === locale ? 'font-semibold underline' : 'opacity-80',
            ]}
          >
            {languageNames[other]}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
